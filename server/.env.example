# ---- WAMS API environment ----
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
DATABASE_URL=

# ---- EMAIL (pick ONE) ----
# A) No-credentials test mode: really sends each verification email to a
#    disposable mailbox; the app shows an "Open my verification email" button.
SMTP_ETHEREAL=true

# B) Real inbox delivery (comment out A above, fill these):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=WAMS CLSU <your-sender@gmail.com>
