# ============================================================
#  WAMS server configuration  (copy this file to ".env")
# ============================================================
# On your own computer:   cp .env.example .env   (then fill in the values)
# NEVER commit the real .env to GitHub. Only this example file is shared.

# --- Basics ---
PORT=4000
JWT_SECRET=change-me-to-any-long-random-string
# Where the front-end runs. Local = http://localhost:5173
# On the live site, set this to your Netlify URL (e.g. https://your-site.netlify.app)
CLIENT_URL=http://localhost:5173
# Allowed front-end origin for CORS. Local can stay *; live = your Netlify URL.
CLIENT_ORIGIN=*

# --- Database ---
# Leave DATABASE_URL EMPTY for local use -> a fast in-memory database is used
# (data resets when the server restarts). On the live host, set this to your
# PostgreSQL connection string so data is saved permanently.
DATABASE_URL=

# ============================================================
#  EMAIL  (pick ONE option)
# ============================================================

# ---- OPTION A: Gmail, for LOCAL use only -------------------
# Works great on your own computer. Does NOT work on free cloud hosts
# (Railway/Render), because they block the SMTP port Gmail uses.
# Get an App Password: Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=WAMS CLSU <youremail@gmail.com>

# ---- OPTION C: Gmail API, for the LIVE site ----------------
# Sends from your own Gmail over HTTPS (works on Railway/Render, no relay review).
# Get these from Google Cloud Console (OAuth client) + the OAuth Playground (refresh token).
# If all three are set, Gmail API is used (it takes priority over everything else).
# Keep SMTP_FROM set to the same Gmail address you authorized.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- OPTION B: Mailjet, for the LIVE site ------------------
# Sends over HTTPS, which cloud hosts do NOT block. Works on Railway/Render.
# Sign up free at mailjet.com, verify your sender email, then copy the two keys
# from Account Settings -> API Key Management. If these two are set, Mailjet is used.
# (Leave SMTP_FROM set to your verified sender address.)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
